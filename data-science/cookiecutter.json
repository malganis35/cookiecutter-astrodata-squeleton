{
    "project_name": "project_name",
    "repo_name": "{{ cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_') }}",
    "package_name": "{{ cookiecutter.repo_name.lower().replace(' ', '_').replace('-', '_') }}",
    "author_name": "Your name (or your organization/company/team)",
    "author_email": "your.email@example.com",
    "project_url": "https://github.com/your-org/your-repo",
    "description": "A short description of the project.",
    "open_source_license": [
        "No license file",
        "MIT",
        "BSD-3-Clause"
    ],
    "python_version": "3.12.0",
    "_py_major": "{{ cookiecutter.python_version.split('.')[0] }}",
    "_py_minor": "{{ cookiecutter.python_version.split('.')[1]|int }}",
    "_python_matrix": "[ '{{ cookiecutter._py_major }}.{{ cookiecutter._py_minor - 3 }}', '{{ cookiecutter._py_major }}.{{ cookiecutter._py_minor - 2 }}', '{{ cookiecutter._py_major }}.{{ cookiecutter._py_minor - 1 }}' ]",
    "install_precommit": [
        "yes",
        "no"
    ],
    "initialize_sphinx_documentation": [
        "yes",
        "no"
    ]
}